# For now, it will return an empty video, or a dummy video

import os
import subprocess

def create_dummy_video(filename="interview_with_james_simulated.mp4", duration=5): # in seconds
    """Creates a basic dummy video file."""

    if os.path.exists(filename):
        os.remove(filename)

    try:
        # Use ffmpeg for video creation (requires ffmpeg installed)
        command = [
            'ffmpeg',
            '-y',  # Overwrite output file if it exists
            '-f', 'lavfi',
            '-i', f'color=c=black:s=640x480:d={duration}',  # Create a black screen
            '-codec:v', 'libx264',  # Use H.264 video codec
            '-preset', 'ultrafast',  # Fast encoding
            '-pix_fmt', 'yuv420p',  # Compatibility with most players
            filename
        ]
        subprocess.run(command, check=True, capture_output=True)
        print(f"Dummy video '{filename}' created successfully.")

    except FileNotFoundError:
        print("Error: ffmpeg not found. Please install ffmpeg to generate real video.")
    except subprocess.CalledProcessError as e:
        print(f"Error creating video: {e.stderr.decode()}")
    except Exception as e:
        print(f"An unexpected error occurred: {e}")


